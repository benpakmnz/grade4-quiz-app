{
  "rules": {
    ".read": false,
    ".write": false,
    "english": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "content": {
        ".read": true,
        ".write": "auth != null && root.child('english/admins').child(auth.uid).val() === true"
      }
    }
  }
}

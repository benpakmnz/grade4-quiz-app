{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[0-9][0-9][0-9][0-9]$/)",
        ".write": "$room.matches(/^[0-9][0-9][0-9][0-9]$/)"
      }
    },
    "english": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}

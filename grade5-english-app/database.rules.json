{
  "rules": {
    ".read": false,
    ".write": false,
    "$app": {
      "users": {
        ".read": "($app === 'english' || $app === 'english-test') && auth != null && root.child($app).child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "($app === 'english' || $app === 'english-test') && auth != null && auth.uid === $uid",
          ".write": "($app === 'english' || $app === 'english-test') && auth != null && auth.uid === $uid",
          "profile": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "username": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          },
          "progress": {
            "data": {
              "$key": {
                ".validate": "$key.matches(/^english_(userData|score|streak|questionCount|history|categoryStats|achievements|writingDraft|hasSeenWelcome|lessonsSeen|mistakes|resetBackup)$/) && newData.isString() && (newData.val().length <= 200000 || (($key === 'english_mistakes' || $key === 'english_resetBackup') && newData.val().length <= 800000))"
              }
            },
            "clientUpdatedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          },
          "sessions": {
            "$sid": {
              "start": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "last": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "end": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "d": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "k": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "admins": {
        "$uid": {
          ".read": "($app === 'english' || $app === 'english-test') && auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "content": {
        ".read": "$app === 'english' || $app === 'english-test'",
        ".write": "($app === 'english' || $app === 'english-test') && auth != null && root.child($app).child('admins').child(auth.uid).val() === true"
      },
      "visits": {
        ".read": "($app === 'english' || $app === 'english-test') && auth != null && root.child($app).child('admins').child(auth.uid).val() === true",
        "$day": {
          "$visitor": {
            ".write": "($app === 'english' || $app === 'english-test') && newData.exists() && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $visitor.matches(/^[a-z0-9]{8,24}$/)",
            ".validate": "newData.hasChildren(['t', 's'])",
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "s": {
              ".validate": "newData.isBoolean()"
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && (!data.exists() || newData.val() <= data.val() + 1)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "presence": {
        ".read": "($app === 'english' || $app === 'english-test') && auth != null && root.child($app).child('admins').child(auth.uid).val() === true",
        "$visitor": {
          ".write": "($app === 'english' || $app === 'english-test') && $visitor.matches(/^[a-z0-9]{8,24}$/)",
          ".validate": "newData.hasChildren(['t', 's'])",
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "s": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}

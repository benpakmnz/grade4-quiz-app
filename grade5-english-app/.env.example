# Firebase - התחברות עם Google ושמירת ההתקדמות בענן (ראו README).
# בלי הערכים האלה האפליקציה עובדת כרגיל, וההתקדמות נשמרת רק בדפדפן.
# הערכים נמצאים ב-Firebase Console ← Project settings ← Your apps ← Web app.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=rotem-heart-bank.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://rotem-heart-bank-default-rtdb.europe-west1.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=rotem-heart-bank
REACT_APP_FIREBASE_APP_ID=

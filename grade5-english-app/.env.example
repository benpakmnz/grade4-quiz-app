# Firebase - התחברות עם Google ושמירת ההתקדמות בענן (ראו README).
# בלי הערכים האלה האפליקציה עובדת כרגיל, וההתקדמות נשמרת רק בדפדפן.
# הערכים נמצאים ב-Firebase Console ← Project settings ← Your apps ← Web app (firebaseConfig),
# וכתובת המסד בראש הלשונית Realtime Database ← Data.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_APP_ID=

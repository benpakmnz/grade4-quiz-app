# פרטי ה-Firebase של האפליקציה (english-practice-87420) כבר נמצאים בקוד: src/services/firebase.js
# אין צורך להגדיר כלום. המשתנים כאן רק למקרה שרוצים פרויקט Firebase אחר:
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_DATABASE_URL=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_APP_ID=

# לעבוד בלי התחברות וענן (רק בדפדפן):
# REACT_APP_FIREBASE_DISABLED=true
